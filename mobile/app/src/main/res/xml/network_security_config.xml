<?xml version="1.0" encoding="utf-8"?>
<!--
  后端是局域网自托管服务（http://192.168.x.x:8000），必须放行明文 HTTP。
  只放行明文，不降低其他安全校验。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
